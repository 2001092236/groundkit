# ---------- Модели (нужен хотя бы один ключ; порядок ниже = порядок fallback) ----------
GROQ_API_KEY=              # https://console.groq.com/keys      — 1000 запросов/день, из РФ API недоступен
CLOUDFLARE_API_KEY=        # https://dash.cloudflare.com        — 10 000 нейронов/день (токен Workers AI)
CLOUDFLARE_ACCOUNT_ID=     # там же, Account ID
GIGACHAT_AUTH_KEY=         # https://developers.sber.ru/studio  — ключ авторизации (base64 client_id:client_secret)
GIGACHAT_SCOPE=GIGACHAT_API_PERS   # физлицо: 1 млн токенов на 12 месяцев. Юрлицо: GIGACHAT_API_CORP
# Сертификат Минцифры для TLS Сбера (в Docker уже вшит). Локально:
#   curl -o ~/russian_trusted_root_ca.cer https://gu-st.ru/content/Other/doc/russian_trusted_root_ca.cer
# GIGACHAT_CA_BUNDLE=/Users/you/russian_trusted_root_ca.cer
ZAI_API_KEY=                # https://z.ai/manage-apikey/apikey-list — GLM-4.7-Flash бесплатна бессрочно
OPENROUTER_API_KEY=        # https://openrouter.ai/keys         — 50 запросов/день на free-моделях
MISTRAL_API_KEY=           # https://console.mistral.ai         — включите Free mode, лимиты в Admin Panel
CEREBRAS_API_KEY=          # https://cloud.cerebras.ai          — 14 400 запросов/день после активации
GEMINI_API_KEY=            # https://aistudio.google.com/apikey — ~1500 запросов/день, не для аккаунтов из РФ
ANTHROPIC_API_KEY=         # https://console.anthropic.com      — платный API (для продакшна)
GROUNDKIT_USAGE_FILE=      # журнал лимитов, по умолчанию ~/.groundkit/usage.json

# ---------- Картинки (тоже опционально: Pollinations работает без ключа) ----------
HF_TOKEN=                  # https://huggingface.co/settings/tokens — ZeroGPU: ~5 мин GPU в сутки
POLLINATIONS_TOKEN=        # https://auth.pollinations.ai — быстрее лимит, nologo и private
POLLINATIONS_REFERRER=groundkit

# Claude Code CLI как модель — только для локальных экспериментов, не для бэкенда чужих пользователей.
GROUNDKIT_CLAUDE_CLI=0

# ---------- Поиск (всё опционально: SearXNG, DuckDuckGo и Jina работают без ключей) ----------
SEARXNG_URL=http://localhost:8080
EXA_API_KEY=               # https://dashboard.exa.ai          — 20 000 запросов/мес
BRAVE_API_KEY=             # https://brave.com/search/api      — 2000 запросов/мес
JINA_API_KEY=              # https://jina.ai                   — без ключа 20 запр/мин, с ключом больше

# ---------- Веб-демо ----------
GROUNDKIT_SEARCH=searxng,ddg,jina   # цепочка поиска по умолчанию
GROUNDKIT_RPM=6                     # лимит запросов в минуту с одного IP
GROUNDKIT_RPD=80                    # лимит в сутки с одного IP
GROUNDKIT_IMAGES=1              # 0 — выключить генерацию картинок в демо
GROUNDKIT_ACCESS_TOKEN=             # если задан — API требует заголовок X-Access-Token
GROUNDKIT_DOMAIN=localhost          # домен для Caddy/HTTPS в docker compose
SEARXNG_SECRET=change-me-please
